<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>DonClaw.Tray</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>DonClawNode</AssemblyName>
    <Version>8.5.3</Version>
    <FileVersion>8.5.3.0</FileVersion>
    <AssemblyVersion>8.5.3.0</AssemblyVersion>
    <Product>DonClaw Node</Product>
    <Description>Connect your PC to DonClaw</Description>
    <ApplicationIcon>Assets\donclaw.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DonClaw.Shared\DonClaw.Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- WebP encoding for screen.capture / screen.perceive (smaller payloads
         for AI control loop). WIC on net10-windows doesn't expose WebP,
         so we lean on SkiaSharp which bundles libwebp. -->
    <PackageReference Include="SkiaSharp" Version="2.88.8" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="2.88.8" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
