<?xml version="1.0" encoding="utf-8"?>
<winex:WindowEx
    x:Class="DonClawTray.Windows.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:winex="using:WinUIEx"
    Title="DonClaw Node — Settings"
    MinWidth="420" MinHeight="400">

    <Window.SystemBackdrop>
        <MicaBackdrop/>
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Scrollable content -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="28,28,28,12">
            <StackPanel Spacing="24" MaxWidth="380">

                <!-- Logo / Branding -->
                <StackPanel Spacing="4">
                    <TextBlock Text="DonClaw Node" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="Connect your PC to your DonClaw instance."
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <!-- Connection Section -->
                <StackPanel Spacing="10">
                    <TextBlock Text="CONNECTION" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               FontWeight="SemiBold"/>

                    <TextBox x:Name="GatewayHostTextBox"
                             Header="Gateway Host"
                             PlaceholderText="ws://my-instance.donclaw.com:18789"
                             ToolTipService.ToolTip="The WebSocket URL of your DonClaw gateway"/>

                    <TextBox x:Name="TokenTextBox"
                             Header="Token"
                             PlaceholderText="Your API token"
                             ToolTipService.ToolTip="Your DonClaw authentication token"/>

                    <TextBlock x:Name="StatusLabel"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="Collapsed"/>
                </StackPanel>

                <!-- Startup Section -->
                <StackPanel Spacing="8">
                    <TextBlock Text="STARTUP" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               FontWeight="SemiBold"/>

                    <ToggleSwitch x:Name="AutoStartToggle" Header="Start automatically with Windows"/>
                </StackPanel>

                <!-- Notifications Section -->
                <StackPanel Spacing="8">
                    <TextBlock Text="NOTIFICATIONS" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               FontWeight="SemiBold"/>

                    <ToggleSwitch x:Name="NotificationsToggle" Header="Show toast notifications"/>
                    <TextBlock Text="Get notified when commands are received from your DonClaw agent."
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Device Info Section (shown when paired) -->
                <StackPanel x:Name="DeviceInfoPanel" Spacing="8" Visibility="Collapsed">
                    <TextBlock Text="DEVICE" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="DeviceIdLabel"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               IsTextSelectionEnabled="True"/>
                    <TextBlock x:Name="PairingStatusLabel"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Fixed footer -->
        <Border Grid.Row="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="28,16">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="OnCancel" Width="90"/>
                <Button x:Name="SaveButton" Content="Save &amp; Connect"
                        Click="OnSave" Width="140" Style="{ThemeResource AccentButtonStyle}"/>
            </StackPanel>
        </Border>
    </Grid>
</winex:WindowEx>
